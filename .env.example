# Placeholders only. Copy to .env and fill in locally; never commit real values.
# All data handled by Medissy in this prototype is synthetic.

# Public HTTPS origin of the deployed Medissy service (used for Agent Card and OIDC redirects)
MEDISSY_PUBLIC_URL=https://medissy.example.invalid

# Anthropic API key for the bounded relevance-selection model call (synthetic data only)
ANTHROPIC_API_KEY=replace-me

# Fly Sprites Box connector identifiers (discovered from the connector details; no Box OAuth credentials here)
BOX_GATEWAY_CONNECTION_ID=replace-me
BOX_ALLOWED_FOLDER_ID=replace-me
# Curated record catalogue (synthetic) that classifies imported Box files; no credentials
BOX_CURATION_PATH=./fixtures/synthetic/records.json
# Records clinicians hand back (submit-record, ADR-10): unset = skill unavailable;
# "box" files into BOX_ALLOWED_FOLDER_ID (only after the connector policy allows
# /upload/files/content, see scripts/deploy.md); "fixture" is an in-memory
# local/test store, refused under NODE_ENV=production
# MEDISSY_INBOUND_STORE=
# Optional: curated conflict links (a manifest with a `conflicts` list); defaults to fixtures/synthetic/manifest.json
# CONFLICTS_PATH=./fixtures/synthetic/manifest.json

# Path to the SQLite database file on the Sprite's persistent volume
DATABASE_PATH=./data/medissy.sqlite

# Comma-separated random keys used to sign demo identity provider cookies
DEMO_IDP_COOKIE_KEYS=replace-me-with-random-key

# Base64url of 32 random bytes; encrypts the demo IdP signing key at rest.
# Required when MEDISSY_PUBLIC_URL is https.
DEMO_IDP_KEY_ENCRYPTION_KEY=replace-me

# Per-persona demo IdP passphrases (synthetic accounts only). Each value is
# plaintext (at least 20 characters, hashed with scrypt at boot) or a
# `scrypt$<salt>$<hash>` string from hashPassphrase. A persona left unset
# cannot sign in. The owner's passphrase is separate from every clinician's.
# Generate each one at random, e.g. `openssl rand -base64 24`: failed guesses
# lock only the guessing client, so the passphrase itself must resist guessing.
DEMO_IDP_SECRET_OWNER=replace-me
DEMO_IDP_SECRET_CARDIOLOGIST=replace-me
DEMO_IDP_SECRET_DENTIST=replace-me
DEMO_IDP_SECRET_UNKNOWN_CLINICIAN=replace-me

# Set to 1 behind the Sprite TLS proxy so X-Forwarded-* from that one hop is
# trusted; requests for any host other than MEDISSY_PUBLIC_URL's get 421.
# 0 is for local http only: the Sprite (an https MEDISSY_PUBLIC_URL) needs 1,
# and Medissy refuses to boot without it there.
TRUST_PROXY=0
